<Window x:Class="ARMStored.Views.OperationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Складская операция" 
        Height="560" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF5F5F5"
        FontFamily="Segoe UI">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="🔄 Новая операция" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="#FF333333"
                   Margin="0,0,0,20"/>

        <!-- Форма -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Тип операции *" FontSize="12" Foreground="#FF666666" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding OperationTypes}"
                      SelectedItem="{Binding SelectedOperationType}"
                      Height="40" 
                      FontSize="14"
                      Background="White"
                      BorderBrush="#FFE0E0E0"
                      BorderThickness="1.5"
                      Margin="0,0,0,15"/>

            <TextBlock Text="Товар *" FontSize="12" Foreground="#FF666666" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding Products}"
                      SelectedValue="{Binding ProductId}"
                      SelectedValuePath="Id"
                      DisplayMemberPath="Name"
                      Height="40" 
                      FontSize="14"
                      Background="White"
                      BorderBrush="#FFE0E0E0"
                      BorderThickness="1.5"
                      Margin="0,0,0,15"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Количество *" FontSize="12" Foreground="#FF666666" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Quantity}" 
                             Height="40" 
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             Background="White"
                             BorderBrush="#FFE0E0E0"
                             BorderThickness="1.5"
                             Margin="0,0,0,15"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Цена за ед. *" FontSize="12" Foreground="#FF666666" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding UnitPrice}" 
                             Height="40" 
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             Background="White"
                             BorderBrush="#FFE0E0E0"
                             BorderThickness="1.5"
                             Margin="0,0,0,15"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Причина / Примечания" FontSize="12" Foreground="#FF666666" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Notes}" 
                     Height="100" 
                     Padding="10,8"
                     FontSize="14"
                     Background="White"
                     BorderBrush="#FFE0E0E0"
                     BorderThickness="1.5"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,15"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="💾 Сохранить" 
                    Click="SaveButton_Click"
                    Height="45"
                    Padding="25,0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#FF4CAF50"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,10,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="❌ Отмена" 
                    Click="CancelButton_Click"
                    Height="45"
                    Padding="25,0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#FF757575"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
