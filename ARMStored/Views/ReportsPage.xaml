<UserControl x:Class="ARMStored.Views.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="#FFF5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="📊 Отчёты и аналитика" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="#FF333333"
                   Margin="0,0,0,20"/>

        <!-- Панель выбора отчёта -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="12" 
                Padding="20" 
                Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="ТИП ОТЧЁТА" 
                           FontSize="11" 
                           FontWeight="SemiBold"
                           Foreground="#FF757575" 
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="📦 Остатки на складе" 
                                 GroupName="ReportType"
                                 Checked="StockReport_Checked"
                                 Margin="0,0,25,0"
                                 FontSize="14"
                                 Foreground="#FF424242"/>
                    <RadioButton Content="🔄 Оборот товаров" 
                                 GroupName="ReportType"
                                 Checked="TurnoverReport_Checked"
                                 Margin="0,0,25,0"
                                 FontSize="14"
                                 Foreground="#FF424242"/>
                    <RadioButton Content="📋 Журнал операций" 
                                 GroupName="ReportType"
                                 Checked="OperationsReport_Checked"
                                 FontSize="14"
                                 Foreground="#FF424242"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Панель фильтров -->
        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="12" 
                Padding="20" 
                Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="С:" FontSize="11" Foreground="#FF757575" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding FilterFrom}" 
                                Width="140" 
                                Height="35"
                                FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                    <TextBlock Text="По:" FontSize="11" Foreground="#FF757575" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding FilterTo}" 
                                Width="140" 
                                Height="35"
                                FontSize="13"/>
                </StackPanel>

                <!-- Фильтр типа операции — ВИДЕН ТОЛЬКО для Журнала операций -->
                <StackPanel Grid.Column="2" Margin="0,0,20,0"
                            x:Name="OperationTypeFilterPanel"
                            Visibility="Collapsed">
                    <TextBlock Text="Тип операции:" FontSize="11" Foreground="#FF757575" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding OperationTypes}"
                              SelectedValue="{Binding SelectedOperationType}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Name"
                              Width="160" 
                              Height="35"
                              FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="🔄 Обновить" 
                            Command="{Binding RefreshCommand}"
                            Height="35"
                            Padding="15,0"
                            Background="#FF2196F3"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="0,0,10,0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="📥 CSV" 
                            Command="{Binding ExportCsvCommand}"
                            Height="35"
                            Padding="15,0"
                            Background="#FF4CAF50"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="0,0,10,0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="🖨️ Печать" 
                            Command="{Binding PrintCommand}"
                            Height="35"
                            Padding="15,0"
                            Background="#FF757575"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Таблица отчёта -->
        <Border Grid.Row="3" 
                Background="White" 
                CornerRadius="12"
                Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>

            <Grid>
                <!-- Отчёт по остаткам -->
                <DataGrid x:Name="StockDataGrid"
                          ItemsSource="{Binding StockReport}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          RowHeight="38"
                          AlternatingRowBackground="#FFF8F9FA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="2*"/>
                        <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="100"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                        <DataGridTextColumn Header="Мин." Binding="{Binding MinQuantity}" Width="70"/>
                        <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="60"/>
                        <DataGridTemplateColumn Header="Статус" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" 
                                            Padding="8,3"
                                            HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FF66BB6A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Критический">
                                                        <Setter Property="Background" Value="#FFE53935"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Низкий">
                                                        <Setter Property="Background" Value="#FFFFA726"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" 
                                                   Foreground="White" 
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=C}" Width="100"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalValue, StringFormat=C}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Отчёт по оборотам -->
                <DataGrid x:Name="TurnoverDataGrid"
                          ItemsSource="{Binding TurnoverReport}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          RowHeight="38"
                          AlternatingRowBackground="#FFF8F9FA"
                          Visibility="Collapsed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="2*"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="130"/>
                        <DataGridTextColumn Header="Приход" Binding="{Binding IncomingQty}" Width="80"/>
                        <DataGridTextColumn Header="Расход" Binding="{Binding OutgoingQty}" Width="80"/>
                        <DataGridTextColumn Header="Списание" Binding="{Binding WriteOffQty}" Width="80"/>
                        <DataGridTextColumn Header="Ср. цена" Binding="{Binding AvgPrice, StringFormat=C}" Width="100"/>
                        <DataGridTextColumn Header="Оборот" Binding="{Binding Turnover, StringFormat=C}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Журнал операций -->
                <DataGrid x:Name="OperationsDataGrid"
                          ItemsSource="{Binding OperationsReport}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          RowHeight="38"
                          AlternatingRowBackground="#FFF8F9FA"
                          Visibility="Collapsed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding OperationDate, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="110"/>
                        <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="2*"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat=C}" Width="90"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat=C}" Width="100"/>
                        <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="120"/>
                        <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Статусная строка -->
        <Border Grid.Row="4" 
                Background="#FFE8F5E9" 
                CornerRadius="8" 
                Padding="12,8" 
                Margin="0,10,0,0"
                Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="#FF2E7D32"
                       FontSize="12"
                       FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
