<Window x:Class="ARMStored.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АРМ Кладовщика - Авторизация" 
        Height="650" Width="480"
        MinHeight="620" MinWidth="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#FFF0F2F5"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFE3F2FD" Offset="0"/>
                <GradientStop Color="#FFF0F2F5" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="White" 
                CornerRadius="16" 
                Padding="45,40" 
                Margin="25,20"
                VerticalAlignment="Center"
                MaxWidth="420">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.15" Color="#FF000000"/>
            </Border.Effect>

            <StackPanel>
                <Border Width="80" Height="80" 
                        CornerRadius="40" 
                        Background="#FF2196F3"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                    <TextBlock Text="📦" 
                               FontSize="40" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Margin="0,2,0,0"/>
                </Border>

                <TextBlock Text="СКЛАДСКОЙ УЧЁТ" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Foreground="#FF1565C0"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Автоматизированное рабочее место кладовщика" 
                           FontSize="13" 
                           HorizontalAlignment="Center"
                           Foreground="#FF757575"
                           Margin="0,0,0,35"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>

                <TextBlock Text="ЛОГИН" 
                           FontSize="11" 
                           FontWeight="SemiBold"
                           Foreground="#FF616161" 
                           Margin="0,0,0,6"/>
                <Border BorderBrush="#FFE0E0E0" 
                        BorderThickness="1.5" 
                        CornerRadius="8"
                        Background="#FFFAFAFA"
                        Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="👤" 
                                   FontSize="18" 
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#FF9E9E9E"/>
                        <TextBox x:Name="UsernameTextBox"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Column="1"
                                 Height="48"
                                 Padding="0,0,12,0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="15"
                                 Foreground="#FF212121"/>
                    </Grid>
                </Border>

                <TextBlock Text="ПАРОЛЬ" 
                           FontSize="11" 
                           FontWeight="SemiBold"
                           Foreground="#FF616161" 
                           Margin="0,0,0,6"/>
                <Border BorderBrush="#FFE0E0E0" 
                        BorderThickness="1.5" 
                        CornerRadius="8"
                        Background="#FFFAFAFA"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔒" 
                                   FontSize="18" 
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#FF9E9E9E"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Grid.Column="1"
                                     Height="48"
                                     Padding="0,0,12,0"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="15"
                                     Foreground="#FF212121"/>
                    </Grid>
                </Border>

                <CheckBox Content="Запомнить меня" 
                          Margin="0,5,0,18"
                          Foreground="#FF757575"
                          FontSize="12"/>

                <Border Background="#FFFFEBEE" 
                        CornerRadius="8" 
                        Padding="12,10"
                        Margin="0,0,0,18"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" 
                               Foreground="#FFC62828"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </Border>

                <Button Content="ВОЙТИ В СИСТЕМУ" 
                        Height="55"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#FF2196F3"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding LoginCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="10"
                                    Height="{TemplateBinding Height}">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF1976D2"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#FF0D47A1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#FF90CAF9"/>
                                    <Setter Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Margin="0,18,0,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" 
                                 Height="3"
                                 Foreground="#FF2196F3"
                                 Background="Transparent"
                                 BorderThickness="0"/>
                    <TextBlock Text="Вход в систему..." 
                               HorizontalAlignment="Center"
                               FontSize="12"
                               Foreground="#FF757575"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <TextBlock Text="© 2024 АРМ Кладовщика v1.0" 
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="#FFBDBDBD"
                           Margin="0,25,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
