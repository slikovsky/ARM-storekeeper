<UserControl x:Class="ARMStored.Views.WarehouseOperationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" 
             d:DesignWidth="900">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🔄 Складские операции" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="#FF333333"
                   Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker SelectedDate="{Binding FilterFrom}" Margin="0,0,20,0"/>
            <TextBlock Text="По:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker SelectedDate="{Binding FilterTo}" Margin="0,0,20,0"/>
            <Button Content="🔄 Обновить" 
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="➕ Новая операция" 
                    Command="{Binding AddOperationCommand}"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>

        <Border Grid.Row="3" 
                Background="White" 
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            
            <DataGrid ItemsSource="{Binding Operations}"
                      SelectedItem="{Binding SelectedOperation}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      RowHeight="40"
                      AlternatingRowBackground="#FFF5F5F5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding OperationDate, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="120"/>
                    <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat=C}" Width="100"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat=C}" Width="100"/>
                    <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="120"/>
                    <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" 
                Background="White" 
                CornerRadius="8"
                Padding="25"
                Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="500">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3"/>
            </Border.Effect>
            
            <StackPanel>
                <TextBlock Text="Новая операция" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Тип операции" FontSize="11" Foreground="#FF666666"/>
                <ComboBox ItemsSource="{Binding OperationTypes}"
                          SelectedItem="{Binding NewOperation.Type}"
                          Height="35" Margin="0,5,0,15"/>

                <TextBlock Text="Товар" FontSize="11" Foreground="#FF666666"/>
                <ComboBox ItemsSource="{Binding Products}"
                          SelectedValue="{Binding NewOperation.ProductId}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          Height="35" Margin="0,5,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Количество" FontSize="11" Foreground="#FF666666"/>
                        <TextBox Text="{Binding NewOperation.Quantity}" Height="35" Margin="0,5,0,0"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Цена за ед." FontSize="11" Foreground="#FF666666"/>
                        <TextBox Text="{Binding NewOperation.UnitPrice}" Height="35" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Причина / Примечания" FontSize="11" Foreground="#FF666666" Margin="0,15,0,0"/>
                <TextBox Text="{Binding NewOperation.Notes}" 
                         Height="60" 
                         Margin="0,5,0,20"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="💾 Сохранить" 
                            Command="{Binding SaveOperationCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,10,0"/>
                    <Button Content="❌ Отмена" 
                            Command="{Binding CancelCommand}"
                            Background="#FF9E9E9E"
                            Foreground="White"
                            Padding="15,8"
                            BorderThickness="0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>