<UserControl x:Class="ARMStored.Views.WarehouseOperationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Background="#FFF5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="🔄 Складские операции" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="#FF333333"
                   Margin="0,0,0,15"/>

        <!-- Фильтры -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker SelectedDate="{Binding FilterFrom}" Margin="0,0,20,0"/>
            <TextBlock Text="По:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker SelectedDate="{Binding FilterTo}" Margin="0,0,20,0"/>
            <ComboBox ItemsSource="{Binding OperationTypes}"
                      SelectedValue="{Binding SelectedOperationType}"
                      SelectedValuePath="Value"
                      DisplayMemberPath="Name"
                      Width="160" 
                      Height="35"
                      Margin="0,0,20,0"/>
            <Button Content="🔄 Обновить" 
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="➕ Новая операция" 
                    Command="{Binding AddOperationCommand}"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>

        <!-- Таблица операций -->
        <Border Grid.Row="3" 
                Background="White" 
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding Operations}"
                      SelectedItem="{Binding SelectedOperation}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      RowHeight="40"
                      AlternatingRowBackground="#FFF5F5F5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding OperationDate, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="120"/>
                    <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat=C}" Width="100"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat=C}" Width="100"/>
                    <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="120"/>
                    <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
