<Window x:Class="ARMStored.Views.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" 
        Height="550" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF5F5F5"
        FontFamily="Segoe UI">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock x:Name="TitleText"
                   Text="Добавление товара" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="#FF333333"
                   Margin="0,0,0,20"/>

        <!-- Форма -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Название *" FontSize="12" Foreground="#FF666666" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Product.Name}" 
                         Height="40" 
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         Background="White"
                         BorderBrush="#FFE0E0E0"
                         BorderThickness="1.5"
                         Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Артикул" FontSize="12" Foreground="#FF666666" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Product.Article}" 
                                 Height="40" 
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 Background="White"
                                 BorderBrush="#FFE0E0E0"
                                 BorderThickness="1.5"
                                 Margin="0,0,0,15"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Штрихкод" FontSize="12" Foreground="#FF666666" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Product.Barcode}" 
                                 Height="40" 
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 Background="White"
                                 BorderBrush="#FFE0E0E0"
                                 BorderThickness="1.5"
                                 Margin="0,0,0,15"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Категория" FontSize="12" Foreground="#FF666666" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedValue="{Binding Product.CategoryId}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          Height="40" 
                          FontSize="14"
                          Background="White"
                          BorderBrush="#FFE0E0E0"
                          BorderThickness="1.5"
                          Margin="0,0,0,15"/>

                <TextBlock Text="Поставщик" FontSize="12" Foreground="#FF666666" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Suppliers}"
                          SelectedValue="{Binding Product.SupplierId}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          Height="40" 
                          FontSize="14"
                          Background="White"
                          BorderBrush="#FFE0E0E0"
                          BorderThickness="1.5"
                          Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Цена *" FontSize="12" Foreground="#FF666666" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Product.Price}" 
                                 Height="40" 
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 Background="White"
                                 BorderBrush="#FFE0E0E0"
                                 BorderThickness="1.5"
                                 Margin="0,0,0,15"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Количество *" FontSize="12" Foreground="#FF666666" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Product.Quantity}" 
                                 Height="40" 
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 Background="White"
                                 BorderBrush="#FFE0E0E0"
                                 BorderThickness="1.5"
                                 Margin="0,0,0,15"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Мин. запас" FontSize="12" Foreground="#FF666666" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Product.MinQuantity}" 
                                 Height="40" 
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 Background="White"
                                 BorderBrush="#FFE0E0E0"
                                 BorderThickness="1.5"
                                 Margin="0,0,0,15"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Единица измерения" FontSize="12" Foreground="#FF666666" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Product.Unit}" 
                         Height="40" 
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         Background="White"
                         BorderBrush="#FFE0E0E0"
                         BorderThickness="1.5"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Описание" FontSize="12" Foreground="#FF666666" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Product.Description}" 
                         Height="80" 
                         Padding="10,5"
                         FontSize="14"
                         Background="White"
                         BorderBrush="#FFE0E0E0"
                         BorderThickness="1.5"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="💾 Сохранить" 
                    Click="SaveButton_Click"
                    Height="45"
                    Padding="25,0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#FF4CAF50"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,10,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="❌ Отмена" 
                    Click="CancelButton_Click"
                    Height="45"
                    Padding="25,0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#FF757575"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
