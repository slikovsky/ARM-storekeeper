<Window x:Class="ARMStored.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АРМ Кладовщика" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F5"
        WindowState="Maximized">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1A237E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#FF283593" Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,30,20,30">
                    <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="Складской учёт" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Content="📋 Товары" 
                            Style="{StaticResource NavButton}"
                            Command="{Binding ShowProductsCommand}"
                            FontSize="14"/>
                    
                    <Button Content="🔄 Операции" 
                            Style="{StaticResource NavButton}"
                            Command="{Binding ShowOperationsCommand}"
                            FontSize="14"/>
                </StackPanel>

                <Border Grid.Row="2" 
                        Background="#FF1A237E" 
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="{Binding UserName}" 
                                   Foreground="White" 
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                        <TextBlock Text="{Binding UserRole}" 
                                   Foreground="#FF90CAF9" 
                                   FontSize="11"
                                   Margin="0,2,0,10"/>
                        <Button Content="🚪 Выйти" 
                                Style="{StaticResource NavButton}"
                                Command="{Binding LogoutCommand}"
                                Padding="0"
                                FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" 
                        Content="{Binding CurrentView}"
                        Margin="20"/>
    </Grid>
</Window>