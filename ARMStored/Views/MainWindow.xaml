<Window x:Class="ARMStored.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АРМ Кладовщика" 
        Height="750" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F5"
        WindowState="Maximized">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="0">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1A237E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="#FF1A237E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель -->
        <Border Background="#FF283593" Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <StackPanel Grid.Row="0" Margin="20,25,20,20">
                    <Border Width="50" Height="50" 
                            CornerRadius="25" 
                            Background="#FF1A237E"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12">
                        <TextBlock Text="📦" 
                                   FontSize="26" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Складской учёт" 
                               FontSize="17" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock Text="АРМ Кладовщика" 
                               FontSize="12" 
                               Foreground="#FF90CAF9"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Separator Grid.Row="1" Background="#FF1A237E" Margin="15,0,15,10"/>

                <!-- Навигация -->
                <StackPanel Grid.Row="2">
                    <Button Content="📋 Товары" 
                            Style="{StaticResource NavButton}"
                            Command="{Binding ShowProductsCommand}"/>

                    <Button Content="🔄 Операции" 
                            Style="{StaticResource NavButton}"
                            Command="{Binding ShowOperationsCommand}"/>

                    <Button Content="📊 Отчёты" 
                            Style="{StaticResource NavButton}"
                            Command="{Binding ShowReportsCommand}"/>
                </StackPanel>

                <!-- Инфо пользователя -->
                <Border Grid.Row="3" 
                        Background="#FF1A237E" 
                        Padding="20,15"
                        Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding UserName}" 
                                   Foreground="White" 
                                   FontWeight="SemiBold"
                                   FontSize="14"/>
                        <TextBlock Text="{Binding UserRole}" 
                                   Foreground="#FF90CAF9" 
                                   FontSize="11"
                                   Margin="0,2,0,12"/>
                        <Button Content="🚪 Выйти из системы" 
                                Style="{StaticResource NavButton}"
                                Command="{Binding LogoutCommand}"
                                Padding="0,8"
                                FontSize="12"
                                Foreground="#FFEF9A9A"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Border Grid.Column="1" 
                Margin="20"
                Background="Transparent">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>
    </Grid>
</Window>
